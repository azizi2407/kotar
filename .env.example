# Kotar — örnek ortam dosyası. Kopyala: cp .env.example .env
# `app.py` `load_dotenv()` ile bunu okur. Prod'da .env yerine gerçek bir secret
# manager (systemd EnvironmentFile, Docker secrets, Infisical/Vault vb.) önerilir.

# --- Zorunlu ---
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=postgresql+psycopg://kotar:kotar@localhost:5432/kotar
FLASK_ENV=production

# --- Kimlik doğrulama (bkz. sso_client.py, auth.py) ---
# AUTH_MODE=oidc  → kurumsal SSO (Keycloak/Authentik/Auth0/Google Workspace vb.)
# AUTH_MODE=local → panelin kendi e-posta/parola girişi (kurulumu en hızlı yol)
AUTH_MODE=local

# AUTH_MODE=oidc iken zorunlu:
# OIDC_ISSUER=https://your-idp.example.com/realms/kotar
# OIDC_CLIENT_ID=kotar-panel
# OIDC_CLIENT_SECRET=change-me
# # Discovery ({issuer}/.well-known/openid-configuration) çalışmıyorsa üçünü elle verin:
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_JWKS_URL=
# OIDC_SCOPE=openid email profile
# # Rol claim'i sağlayıcıya göre değişir (custom claim/attribute) — panel
# # management/designer/videographer/content_creator/pending rollerini bekler.
# OIDC_ROLE_CLAIM=role
# OIDC_DEFAULT_ROLE=pending
# # /api/admin/* kullanıcı yönetimini dış sağlayıcıya proxy'lemek isterseniz
# # (list/create/update users sözleşmesi için bkz. sso_admin.py); boşsa panelin
# # Kullanıcılar sayfası 503 döner — rol yönetimini IdP konsolunuzdan yaparsınız.
# SSO_BASE_URL=
# SSO_ADMIN_TOKEN=

# Impersonation ("kullanıcı gözünden bak") ve superadmin-only işlemler (kullanıcı
# yönetimi, upload silme) yalnız bu e-postalara açık — virgülle ayrık, boşsa kapalı.
SUPERADMIN_EMAILS=

# --- Ajans / panel ---
AGENCY_BASE_URL=https://panel.example.com
AGENCY_NAME=Kotar
# Sharing Board "Müşterilerim" filtresini kullanan yönetici — boşsa özellik kapalı.
AGENCY_OWNER_EMAIL=

# --- Mail modülü (self-servis IMAP/SMTP webmail, bkz. mail_api.py) ---
MAIL_ALLOWED_DOMAINS=example.com
MAIL_DEFAULT_IMAP_HOST=mail.example.com
MAIL_DEFAULT_IMAP_PORT=993
MAIL_DEFAULT_SMTP_HOST=mail.example.com
MAIL_DEFAULT_SMTP_PORT=465
# Parola şifreleme anahtarı (Fernet) — `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
MAIL_ENC_KEY=

# --- Google Drive entegrasyonu (medya deposu, müşteri klasör provizyonu) ---
GOOGLE_SA_JSON=
GOOGLE_DRIVE_TOKEN_JSON=
DRIVE_CONTENT_ROOT_ID=

# --- Push bildirimleri (ntfy.sh veya kendi ntfy sunucunuz) ---
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_PUBLIC_URL=https://ntfy.example.com

# --- AI (caption/brief/görsel üretimi — bkz. ai_claude.py, codex_runner.py) ---
CLAUDE_BIN=claude
CODEX_BIN=codex
CAPTION_MODEL=

# --- Sesli not / transkripsiyon (whisper_service.py) ---
WHISPER_URL=http://127.0.0.1:5040
WHISPER_MODEL=small
VOICE_NOTE_MODEL=

# --- Dosya depolama yolları (yoksa makul varsayılanlar kullanılır) ---
IMG_BUCKET_DIR=
MEDIA_STORE_DIR=
DESIGN_FILES_DIR=
FONT_STORE_DIR=
VOICE_NOTES_DIR=
PLANNING_IMAGE_DIR=
CODEX_IMAGE_DIR=
CODEX_JOB_DIR=

# --- Video araçları ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
