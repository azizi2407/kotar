# Kotar — example environment file. Copy it: cp .env.example .env
# `app.py` reads this via `load_dotenv()`. In production, use a real secret
# manager instead of .env (systemd EnvironmentFile, Docker secrets, Infisical/Vault, etc.).

# --- Required ---
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=postgresql+psycopg://kotar:kotar@localhost:5432/kotar
FLASK_ENV=production

# --- Authentication (see sso_client.py, auth.py) ---
# AUTH_MODE=oidc  → enterprise SSO (Keycloak/Authentik/Auth0/Google Workspace, etc.)
# AUTH_MODE=local → the panel's own email/password login (fastest to set up)
AUTH_MODE=local

# Required when AUTH_MODE=oidc:
# OIDC_ISSUER=https://your-idp.example.com/realms/kotar
# OIDC_CLIENT_ID=kotar-panel
# OIDC_CLIENT_SECRET=change-me
# # If discovery ({issuer}/.well-known/openid-configuration) doesn't work, set these three by hand:
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_JWKS_URL=
# OIDC_SCOPE=openid email profile
# # The role claim varies by provider (custom claim/attribute) — the panel
# # expects one of: management/designer/videographer/content_creator/pending.
# OIDC_ROLE_CLAIM=role
# OIDC_DEFAULT_ROLE=pending
# # If you want to proxy /api/admin/* user management to your external provider
# # (see sso_admin.py for the list/create/update users contract); if unset, the
# # panel's Users page just returns 503 — manage roles from your IdP console instead.
# SSO_BASE_URL=
# SSO_ADMIN_TOKEN=

# Impersonation ("view as a user") and superadmin-only actions (user
# management, deleting uploads) are open only to these emails — comma-separated, off if empty.
SUPERADMIN_EMAILS=

# --- Agency / panel ---
AGENCY_BASE_URL=https://panel.example.com
AGENCY_NAME=Kotar
# The manager whose "My Clients" filter is used on the Sharing Board — feature is off if empty.
AGENCY_OWNER_EMAIL=

# --- Mail module (self-service IMAP/SMTP webmail, see mail_api.py) ---
MAIL_ALLOWED_DOMAINS=example.com
MAIL_DEFAULT_IMAP_HOST=mail.example.com
MAIL_DEFAULT_IMAP_PORT=993
MAIL_DEFAULT_SMTP_HOST=mail.example.com
MAIL_DEFAULT_SMTP_PORT=465
# Password encryption key (Fernet) — `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
MAIL_ENC_KEY=

# --- Google Drive integration (media storage, client folder provisioning) ---
GOOGLE_SA_JSON=
GOOGLE_DRIVE_TOKEN_JSON=
DRIVE_CONTENT_ROOT_ID=

# --- Push notifications (ntfy.sh or your own ntfy server) ---
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_PUBLIC_URL=https://ntfy.example.com

# --- AI (caption/brief/image generation — see ai_claude.py, codex_runner.py) ---
CLAUDE_BIN=claude
CODEX_BIN=codex
CAPTION_MODEL=
# Optional: name of a Claude Code skill (installed in the worker's environment)
# to apply during caption generation, e.g. a house style/naturalization skill.
# Unset = off. See caption.py (_SKILL_TRIGGER) for the format-contract caveat.
# CAPTION_STYLE_SKILL=

# --- Voice notes / transcription (whisper_service.py) ---
WHISPER_URL=http://127.0.0.1:5040
WHISPER_MODEL=small
VOICE_NOTE_MODEL=

# --- File storage paths (sensible defaults are used if unset) ---
IMG_BUCKET_DIR=
MEDIA_STORE_DIR=
DESIGN_FILES_DIR=
FONT_STORE_DIR=
VOICE_NOTES_DIR=
PLANNING_IMAGE_DIR=
CODEX_IMAGE_DIR=
CODEX_JOB_DIR=

# --- Video tools ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
